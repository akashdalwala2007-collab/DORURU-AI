# DORURU-AI — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit or share the actual .env file.

# ---------------------------------------------------------------------------
# General Application Configuration
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Device Security & Authentication
# ---------------------------------------------------------------------------
# Shared secret / token required for ESP32 <-> FastAPI local communication
DEVICE_AUTH_TOKEN=doruru_local_dev_token_placeholder

# ---------------------------------------------------------------------------
# Google Gemini API Configuration
# ---------------------------------------------------------------------------
# Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model name (never hardcode in code; e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Local Speech-to-Text (STT) — faster-whisper
# ---------------------------------------------------------------------------
# Model options: tiny, base, small, medium, large-v3 (or path to local weights)
STT_MODEL_SIZE=base
# Device: cuda (if verified GPU runtime available) or cpu
STT_DEVICE=cpu
# Compute type: int8, float16, float32
STT_COMPUTE_TYPE=int8
# Audio sample rate expected from ESP32 PDM capture (Hz)
STT_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Local Text-to-Speech (TTS) — Piper
# ---------------------------------------------------------------------------
# Path to Piper binary / executable
PIPER_EXECUTABLE_PATH=piper
# Path to ONNX voice model and config
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-lessac-medium.onnx.json

# ---------------------------------------------------------------------------
# College Knowledge Base / RAG Configuration
# ---------------------------------------------------------------------------
COLLEGE_KB_DIR=knowledge_base/documents
COLLEGE_KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLEGE_KB_SIMILARITY_TOP_K=3

# ---------------------------------------------------------------------------
# Movement & Vision Bounds
# ---------------------------------------------------------------------------
MAX_MOVE_DURATION_SECONDS=3.0
MAX_IMAGE_UPLOAD_BYTES=2097152


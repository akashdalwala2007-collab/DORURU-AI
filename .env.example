# DORURU-AI Environment Configuration Template
# Copy this file to .env and configure for local deployment.
# NEVER commit .env to version control!

# Backend Network Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Device Authentication
# Secret token shared between DORURU ESP32 and local backend
DORURU_DEVICE_TOKEN=replace_with_local_device_secret_token
DORURU_ALLOWED_DEVICES=DORURU-SENSE-01,DORURU-DEV

# Google Gemini API Settings (SERVER-SIDE ONLY - NEVER expose to ESP32 firmware)
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable Gemini model identifier (never hardcode in application code)
GEMINI_MODEL=gemini-2.5-flash

# Vision Transport Policies
# Ephemeral image policy: Keep false so images are processed in-memory and discarded
PERSIST_IMAGES=false
MAX_IMAGE_PAYLOAD_BYTES=2097152

# College RAG Knowledge Base Configuration
KNOWLEDGE_BASE_DIR=knowledge_base/documents
INDEX_STORAGE_DIR=knowledge_base/index
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=3
RAG_MIN_SIMILARITY_SCORE=0.15
EMBEDDING_PROVIDER=tfidf_local


